# Copy to .dev.vars for `npm run dev:pages`. In production, set these as Pages secrets:
#   npx wrangler pages secret put <NAME> --project-name felinegait

# Service account JSON (single line) — Firebase console → Project settings → Service accounts → Generate new private key
FIREBASE_SERVICE_ACCOUNT={"client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"}

# Bucket API key (R2: R2 → Manage API tokens, "Object Read & Write" on your bucket · B2: App Keys)
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
