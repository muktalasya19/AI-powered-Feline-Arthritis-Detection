# Firebase service account JSON key (Project settings → Service accounts → Generate new private key)
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# S3-compatible bucket — same values as the web app
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=felinegait-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional
POLL_SECONDS=15
MODEL_VERSION=v0-heuristic
